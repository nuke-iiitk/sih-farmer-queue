# Expo frontend environment (copy to .env — loaded automatically by Expo SDK 49+).
# Only variables prefixed with EXPO_PUBLIC_ reach the JS bundle.

# Base URL of the FastAPI backend. Choose per target:
#   Android emulator:  http://10.0.2.2:8000      (10.0.2.2 = host loopback)
#   iOS simulator:     http://localhost:8000
#   Expo web:          http://localhost:8000
#   Physical device:   http://<YOUR-LAN-IP>:8000 (e.g. http://192.168.1.20:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Set to "false" to run the app purely on bundled mock data (offline demo).
EXPO_PUBLIC_USE_BACKEND=true
