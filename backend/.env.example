# ---------------------------------------------------------------------------
# Kisan Kraya Seva — backend environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection (SQLAlchemy URL). The `postgresql+psycopg://` scheme
# uses psycopg 3 which supports both sync (Alembic) and async (FastAPI) usage.
DATABASE_URL=postgresql+psycopg://kisan_app:CHANGE_ME_kisan_2026@localhost:5432/kisan_procurement

# Separate database used by the automated test-suite (optional but recommended).
TEST_DATABASE_URL=postgresql+psycopg://kisan_app:CHANGE_ME_kisan_2026@localhost:5432/kisan_procurement_test

# Signing key for auth tokens. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# development | test | production
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins (never use * in production).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:5173

# Set to true in production so queue/slot mutations require an officer token.
REQUIRE_OFFICER_AUTH=false

# Average minutes spent per farmer — used for queue wait estimation.
MINUTES_PER_FARMER=7

# Demo OTP accepted for password-less farmer logins (development only).
DEMO_OTP=123456
